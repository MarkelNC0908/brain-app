{
  "name": "brain-app",
  "productName": "Brain",
  "version": "1.0.16",
  "description": "Visor de escritorio para un Brain de apuntes (asignaturas, modo juego, dashboard y avisos)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . \"Brain\" --out=dist --overwrite --prune=true --ignore=\"^/(dist|test)\" --ignore=\"/node_modules/node-pty/build/(Makefile|config\\.gypi|binding\\.Makefile|gyp-mac-tool|node_gyp_bins|Release/(obj\\.target|\\.deps|node-addon-api|\\.forge-meta))\" --ignore=\"/node_modules/pdf-parse/(test|lib/pdf\\.js/v1\\.9\\.426|lib/pdf\\.js/v1\\.10\\.88|lib/pdf\\.js/v2\\.0\\.550)\" --ignore=\"\\.mk$\" --asar.unpackDir=\"node_modules/node-pty\" --platform=darwin --arch=arm64",
    "build:win": "electron-packager . \"Brain\" --out=dist --overwrite --prune=true --ignore=\"^/(dist|test)\" --ignore=\"/node_modules/node-pty/build/(Makefile|config\\.gypi|binding\\.Makefile|gyp-mac-tool|node_gyp_bins|Release/(obj\\.target|\\.deps|node-addon-api|\\.forge-meta))\" --ignore=\"/node_modules/pdf-parse/(test|lib/pdf\\.js/v1\\.9\\.426|lib/pdf\\.js/v1\\.10\\.88|lib/pdf\\.js/v2\\.0\\.550)\" --ignore=\"\\.mk$\" --asar.unpackDir=\"node_modules/node-pty\" --platform=win32 --arch=x64",
    "build:linux": "electron-packager . \"Brain\" --out=dist --overwrite --prune=true --ignore=\"^/(dist|test)\" --ignore=\"/node_modules/node-pty/build/(Makefile|config\\.gypi|binding\\.Makefile|gyp-mac-tool|node_gyp_bins|Release/(obj\\.target|\\.deps|node-addon-api|\\.forge-meta))\" --ignore=\"/node_modules/pdf-parse/(test|lib/pdf\\.js/v1\\.9\\.426|lib/pdf\\.js/v1\\.10\\.88|lib/pdf\\.js/v2\\.0\\.550)\" --ignore=\"\\.mk$\" --asar.unpackDir=\"node_modules/node-pty\" --platform=linux --arch=x64",
    "build:all": "npm run build && npm run build:win && npm run build:linux",
    "test": "node test/run.js",
    "humo": "node test/humo.js"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.18",
    "jszip": "^3.10.2",
    "marked": "^18.2.0",
    "node-pty": "^1.1.0",
    "pdf-parse": "^1.1.1",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@electron/rebuild": "^4.2.1",
    "electron": "^45.3.3",
    "jsdom": "^24.1.3"
  }
}
