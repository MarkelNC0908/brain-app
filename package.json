{
  "name": "brain-app",
  "productName": "Brain",
  "version": "1.0.7",
  "description": "Visor de escritorio para un Brain de apuntes (asignaturas, modo juego, dashboard y avisos)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . \"Brain\" --out=dist --overwrite --prune=true --ignore=\"^/dist\" --ignore=\"/node_modules/node-pty/build/(Makefile|config\\.gypi|binding\\.Makefile|gyp-mac-tool|node_gyp_bins|Release/(obj\\.target|\\.deps|node-addon-api|\\.forge-meta))\" --ignore=\"\\.mk$\" --asar.unpackDir=\"node_modules/node-pty\" --platform=darwin --arch=arm64",
    "build:win": "electron-packager . \"Brain\" --out=dist --overwrite --prune=true --ignore=\"^/dist\" --ignore=\"/node_modules/node-pty/build/(Makefile|config\\.gypi|binding\\.Makefile|gyp-mac-tool|node_gyp_bins|Release/(obj\\.target|\\.deps|node-addon-api|\\.forge-meta))\" --ignore=\"\\.mk$\" --asar.unpackDir=\"node_modules/node-pty\" --platform=win32 --arch=x64",
    "build:linux": "electron-packager . \"Brain\" --out=dist --overwrite --prune=true --ignore=\"^/dist\" --ignore=\"/node_modules/node-pty/build/(Makefile|config\\.gypi|binding\\.Makefile|gyp-mac-tool|node_gyp_bins|Release/(obj\\.target|\\.deps|node-addon-api|\\.forge-meta))\" --ignore=\"\\.mk$\" --asar.unpackDir=\"node_modules/node-pty\" --platform=linux --arch=x64",
    "build:all": "npm run build && npm run build:win && npm run build:linux"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.18",
    "marked": "^18.2.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@electron/rebuild": "^4.2.1",
    "electron": "^45.3.3"
  }
}
